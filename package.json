{
  "name": "paybuddy",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prisma:generate": "prisma generate --schema=database/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=database/schema.prisma",
    "prisma:studio": "prisma studio --schema=database/schema.prisma",
    "db:start": "brew services start postgresql@16",
    "db:stop": "brew services stop postgresql@16"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "bcrypt@6.0.0": true,
    "fsevents@2.3.3": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true
  }
}
