{
  "expo": {
    "name": "PayBuddy",
    "slug": "paybuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "paybuddy",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PayBuddy to scan QR codes"
        }
      ]
    ],
    "android": {
      "package": "com.paybuddy.app"
    },
    "ios": {
      "bundleIdentifier": "com.paybuddy.app"
    }
  }
}